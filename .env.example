# ================= 智能数据分析 Agent 系统 环境配置 =================
# 复制本文件为 .env 后按需修改。所有密钥均通过环境变量注入，禁止硬编码。

# ---- 应用基础 ----
APP_NAME=Data Analysis Agent
DEBUG=false
SECRET_KEY=please-change-me-to-a-long-random-string
JWT_SECRET=please-change-me-to-another-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- 数据库（SQLite）----
DATABASE_URL=sqlite:///./data/app.db

# ---- 上传目录与大小限制 ----
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50

# ---- Celery / Redis ----
# eager = 本地无 Redis 同步执行（Windows 本地调试用）；redis = 生产/Compose 异步队列
CELERY_MODE=eager
REDIS_URL=redis://localhost:6379/0

# ---- LLM（OpenAI 兼容 API，可切换 Ollama / DeepSeek）----
# 本地 Ollama：OPENAI_API_BASE=http://localhost:11434/v1
# Docker 内访问宿主机 Ollama：OPENAI_API_BASE=http://host.docker.internal:11434/v1
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_API_KEY=ollama
MODEL_NAME=qwen2.5:7b
# DeepSeek API（填写 DEEPSEEK_API_KEY 后，即可在前端「模型选择」里切换到 DeepSeek）
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0

# ---- CORS（逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- 接口限流（每 IP / 每用户 每分钟次数）----
RATE_LIMIT_PER_MINUTE=60

# ---- 代码执行沙箱 ----
SANDBOX_TIMEOUT=30
SANDBOX_MAX_MEMORY_MB=512
